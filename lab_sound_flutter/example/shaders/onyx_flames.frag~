#version 460 core
#include <flutter/runtime_effect.glsl>

out vec4 fragColor;

uniform vec2 iResolution;
uniform float iTime;
uniform sampler2D iChannel0;


#define PI 3.14

#define GROUND_HEIGHT 0.25
#define GROUND_MARGIN 0.98
#define GROUND_SPLIT_COLOR vec4(0.1)
#define GROUND_REFLECTION 0.15

#define GROUND_SPLIT_WIDTH 0.2
#define GROUND_SPLIT_CAM_COEF 3.1
#define GROUND_SPLIT_PREC 1.


