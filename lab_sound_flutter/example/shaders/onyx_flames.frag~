    https://soundcloud.com/k-mastamasta/killing-floor-2-fit-for-a-better-king-bitter-end-instrumental
*/

#define FFT_BASE_COLOR vec3(0.25, 0.50, 1.)
#define FFT_AUX_COLOR vec3(1)
#define FFT_DAMP 60.
#define FFT_THRESHOLD 0.0
#define FFT_FTCH 0.2
#define FFT_NORM_SMOOTH 0.1
#define FFT_AMP 1.25

#define FX_FLAME_DAMP 0.95

#define CLAMP_MOUSE
//#define PROACTIVE

#define DRAW_PARTICLES
#define PARTICLE_THRESHOLD 1.2
#define PARTICLE_DECAY 0.99

#define PI 3.14

#define FX_CHANNEL iChannel1
#define SND_CHANNEL iChannel0

struct frag {
    vec2 uv;
    vec2 xy;
    vec4 c;
    vec4 pc;
};

frag gFrag;

// defines or not ?
float GetSndVal(in float idx, in float damp)
{
    return texture(SND_CHANNEL, vec2(idx, damp)).x;
}

vec4 LoadTexel(ivec2 xy)
{
    return texelFetch(FX_CHANNEL, xy, 0);
}

float GetSome(in vec2 xy)
{
    float noise = 1. + abs(cos(iTime * 200.) * 1.);
    return length(
        texelFetch(
            iChannel2,
            ivec2(xy * noise),
            0
        )
    );
}

void getColor(out vec3 base, out vec3 aux)
{
    if (iMouse.z <= 0.)
    {
        base = FFT_BASE_COLOR;
        aux = FFT_AUX_COLOR;
    }
    else
    {
        vec2 muv = iMouse.xy / iResolution.xy;

        base = vec3(
            sin((muv.x - 0.5) * PI),
            sin(   muv.x      * PI),
            sin((muv.x + 0.5) * PI)
        );
        aux = vec3(
            sin((muv.y - 0.5) * PI),
            sin(   muv.y      * PI),
            sin((muv.y + 0.5) * PI)
        );

        #ifdef CLAMP_MOUSE
        base = clamp(base, 0., 1.);
        aux = clamp(aux, 0., 1.);
        #else
        base = (base / 2.) + 0.5;
        aux = (aux / 2.) + 0.5;
        #endif
    }
}

void drawFlames()
{
    float
    x = abs(0.5 - gFrag.uv.x) * FX_FLAME_DAMP,
    y = abs(GROUND_HEIGHT - gFrag.uv.y),
    fft = GetSndVal(x, FFT_FTCH) * FFT_AMP;

    fft -= y;
    #ifdef PROACTIVE
    fft *= (exp((fft - FFT_THRESHOLD) * (fft * 20.)) / FFT_DAMP) - (exp(0.) / FFT_DAMP);
    #else
    fft *= (exp((fft - FFT_THRESHOLD) * 9.5) / FFT_DAMP) - (exp(0.) / FFT_DAMP);
    #endif

    fft *= 1. - x * 1.5;

    vec3 baseColor, auxColor;
    getColor(baseColor, auxColor);

    gFrag.c.rgb = baseColor * fft;
    y *= 2. * (gFrag.uv.y > GROUND_HEIGHT ? 1. : GROUND_REFLECTION);
    gFrag.c.rgb *= (y / (2.-(x * 1.)));
    gFrag.c.rgb *= mix(gFrag.c.rgb, auxColor, y);
}

void drawParticles()
{
    // Update
    if (gFrag.pc.w > 0.) {
        gFrag.c.w = gFrag.pc.w * PARTICLE_DECAY;
        gFrag.c.rgb += gFrag.pc.rgb * gFrag.c.w;
    } else {
        // Creation
        float pMapVal;
        if (gFrag.c.w == 0.
        && length(gFrag.c.rgb) > 1.
        && (pMapVal = GetSome(gFrag.xy)) > 1.7
        )
        gFrag.c.w = clamp(0., 1., pMapVal);
    }
}

void mainImage(out vec4 fragColor, in vec2 fragCoord)
{
    gFrag.xy = fragCoord.xy;
    gFrag.uv = fragCoord.xy / iResolution.xy;
    float yCoef = 1.5 + GetSome(gFrag.uv);
    gFrag.pc = LoadTexel(
        ivec2(
            fragCoord.x,
            fragCoord.y + yCoef * (gFrag.uv.y > GROUND_HEIGHT * 0.98 ? -1. : 1.)
        )
    );

    drawFlames();
    #ifdef DRAW_PARTICLES
    drawParticles();
    #endif

    fragColor = gFrag.c;
}


#define FX_CHANNEL iChannel0

/*
    REMINDER: The browser might prevent the music from playing thus preventing the shader to work
    Reload the page and interact(click) on the WebGL player as soon as possible
*/

struct frag {
    vec2 uv;
    vec4 c;
    vec4 fx;
};

frag gFrag;

void drawGround()
{
    if (gFrag.uv.y >= GROUND_HEIGHT * 0.99)
    return;

    gFrag.c *= 0.25;

    gFrag.c += vec4(0.5 / (40. * (GROUND_HEIGHT - gFrag.uv.y) + 1.6));

    const float
    GSHW = (1. - GROUND_SPLIT_WIDTH) * 100.;

    float d = (GROUND_SPLIT_PREC - gFrag.uv.y * GROUND_SPLIT_CAM_COEF) / GSHW,
    x = gFrag.uv.x - 0.5,
    y = GROUND_HEIGHT * 1.1 - gFrag.uv.y;

    // I've got to get rid of this loop
    for (float n = 1.5; n > 0.1; n /= (n > 1.) ? 4. : 2.)
    if (abs(abs(n * x) - y) < d) {
        gFrag.c += GROUND_SPLIT_COLOR;
        return;
    }

    if (sin(gFrag.uv.y * (GSHW * (1.2 - GROUND_HEIGHT)) * -log(0.6 - gFrag.uv.y) ) > 0.98 + gFrag.uv.y / 15.)
    gFrag.c += GROUND_SPLIT_COLOR;
}

void drawFx()
{
    gFrag.c = gFrag.fx;
}

void mainImage(out vec4 fragColor, in vec2 fragCoord)
{
    gFrag.uv = fragCoord.xy / iResolution.xy;
    gFrag.fx = texelFetch(FX_CHANNEL, ivec2(fragCoord), 0);

    drawFx();

    drawGround();

    gFrag.c.w = 1.;
    fragColor = gFrag.c;
}


void main() {
    vec2 fragCoord = FlutterFragCoord();
    mainImage(fragColor, fragCoord);
}